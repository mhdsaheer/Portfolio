# Copy to .env.local for your machine, and add the same values (except the
# secret key) in Vercel: Project -> Settings -> Environment Variables.

# Supabase: Project Settings -> API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret key. Bypasses Row Level Security - only for
# scripts/seed-insights.ts on your own machine. Never add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_...

# Cloudinary: Dashboard -> Product Environment Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=...

# Any long random string; Vercel Cron sends it to /api/keep-alive.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=...
